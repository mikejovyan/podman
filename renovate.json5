{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  assignees: [ "mikejovyan" ],
  extends: [
    "local>renovate-bot/renovate_config",
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [ "/(^|/)\\.forgejo/workflows/build\\.yml$/" ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)\\s+package_version:\\s*[\"']?(?<currentValue>.+?)[\"']?\\s",
      ],
    },
  ],
}
