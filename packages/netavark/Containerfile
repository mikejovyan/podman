FROM rust:slim-trixie AS builder

RUN --mount=type=cache,id=podman-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=podman-apt-lists,target=/var/lib/apt,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        ca-certificates \
        dpkg-dev \
        make

ARG PACKAGE
# renovate: datasource=github-releases depName=containers/netavark
ARG PACKAGE_VERSION=2.1.0
ARG TARGETARCH

ENV BUILD_GOAL=build \
    COPYRIGHT="2021-2026 Netavark contributors" \
    DEPENDS="" \
    DESCRIPTION="Rust based network stack for containers" \
    INSTALL_GOAL=install.netavark \
    LICENSE=Apache-2.0 \
    RECOMMENDS="aardvark-dns, nftables" \
    REQUIREMENTS="protobuf-compiler" \
    SOURCE=https://github.com/containers/netavark \
    SUGGESTS=""

RUN --mount=type=cache,id=podman-apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=podman-apt-lists,target=/var/lib/apt,sharing=locked \
    export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        ${REQUIREMENTS}

WORKDIR /src

ADD $SOURCE/archive/refs/tags/v${PACKAGE_VERSION}.tar.gz /tmp/src.tar.gz

RUN tar xzf /tmp/src.tar.gz -C /src --strip-components=1 \
    && rm /tmp/src.tar.gz

RUN --mount=type=cache,id=podman-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=podman-cargo-target,target=/src/target,sharing=locked \
    make $BUILD_GOAL PREFIX=/usr \
    && make $INSTALL_GOAL PREFIX=/usr DESTDIR=/out

RUN --mount=type=bind,source=build_deb.sh,target=/build_deb.sh \
    bash /build_deb.sh

FROM scratch AS export
COPY --from=builder /out-deb /
